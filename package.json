{
  "name": "jobpulse-india",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "browser": "agent-browser",
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --passWithNoTests",
    "create:test-users": "node scripts/create-test-auth-users.mjs",
    "import:jobpulse": "node --env-file=.env scripts/import-jobpulse-listings.mjs",
    "cleanup:corrupted-jobs": "node --env-file=.env scripts/fix-corrupted-jobs.mjs",
    "seed:jobs": "node scripts/seed-jobs.mjs",
    "setup:e2e": "node scripts/setup-e2e.mjs",
    "db:setup": "node scripts/setup-mysql.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "verify:panels": "npm run db:setup && npm run db:migrate && npm run seed:jobs && npm run setup:e2e && playwright test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@hookform/resolvers": "^5.4.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.7",
    "lucide-react": "^1.18.0",
    "mysql2": "^3.23.2",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "radix-ui": "^1.5.0",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-browser": "^0.29.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest": "^29.6.1",
    "jest-environment-jsdom": "^29.6.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.0",
    "typescript": "^5"
  }
}
