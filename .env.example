NEXT_PUBLIC_SITE_URL=https://example.com
ENABLE_LIVE_JOB_IMPORT=false
ADMIN_APPROVAL_DISABLED=false
# Hostinger MySQL (hPanel → Databases → Management)
MYSQL_HOST=srvXXX.hstgr.io
MYSQL_PORT=3306
MYSQL_DATABASE=uXXXXXXXX_jobpulse
MYSQL_USER=uXXXXXXXX_jobpulse
MYSQL_PASSWORD=your-database-password
MYSQL_POOL_LIMIT=3

# Session signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=your-64-char-random-hex-secret

# Hostinger email (hPanel → Emails), used for password-reset messages
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM=JobPulse India <no-reply@yourdomain.com>

CRON_SECRET=your-cron-secret
JOB_FETCH_AUTO_PUBLISH=true
JOB_FETCH_AUTO_PUBLISH_MIN_QUALITY=60
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-whatsapp-webhook-verify-token
N8N_JOB_ALERTS_WEBHOOK_URL=https://example.com/webhooks/job-alerts
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your-ga4-api-secret
